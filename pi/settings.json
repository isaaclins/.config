{
  "lastChangelogVersion": "0.80.3",
  "externalEditor": "zed-preview --wait",
  "shellCommandPrefix": "export PATH=\"$HOME/.config/pi/fish-shims:$PATH\"",
  "theme": "dark",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-fable-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "claude-opus-4-8",
    "claude-opus-4-6",
    "claude-sonnet-5",
    "claude-haiku-4-5",
    "claude-fable-5"
  ],
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-powerline-footer",
    "git:github.com/injaneity/pi-computer-use@v0.4.2"
  ],
  "showHardwareCursor": false,
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": true
  },
  "collapseChangelog": true,
  "quietStartup": false,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "powerline": {
    "preset": "default",
    "customItems": [
      {
        "id": "sub-usage-ok",
        "position": "right",
        "prefix": "󰛨 ",
        "color": "success"
      },
      {
        "id": "sub-usage-warn",
        "position": "right",
        "prefix": "󰛨 ",
        "color": "warning"
      },
      {
        "id": "sub-usage-crit",
        "position": "right",
        "prefix": "󰛨 ",
        "color": "error"
      }
    ]
  },
  "subagents": {
    "defaultModel": "claude-haiku-4-5",
    "agentOverrides": {
      "worker": {
        "model": "claude-opus-4-8"
      },
      "oracle": {
        "model": "claude-opus-4-8"
      }
    }
  },
  "followUpMode": "one-at-a-time",
  "transport": "auto"
}