{
  "collapseChangelog": true,
  "defaultModel": "claude-opus-5",
  "defaultProjectTrust": "always",
  "defaultProvider": "anthropic",
  "defaultThinkingLevel": "xhigh",
  "doubleEscapeAction": "tree",
  "enabledModels": [
    "claude-opus-5",
    "claude-fable-5",
    "gpt-5.6-sol",
    "claude-sonnet-5"
  ],
  "externalEditor": "~/.config/pi/pi-external-editor",
  "followUpMode": "one-at-a-time",
  "lastChangelogVersion": "0.80.6",
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:@isaaclins/pi-fish-bridge@0.1.0",
    "npm:@isaaclins/pi-arcoiris-refined@1.0.0",
    "npm:pi-powerline-footer",
    "~/.config/pi/modules/pi-context",
    "~/.config/pi/modules/pi-memory",
    "~/.config/pi/modules/pi-codrive",
    "~/.config/pi/modules/pi-excalidraw",
    "~/.config/pi/modules/pi-tmux-image-preview",
    "~/.config/pi/packages/pi-computer-use-codex-parity",
    "../../Projects/argus"
  ],
  "powerline": {
    "customItems": [
      {
        "color": "accent",
        "id": "effort",
        "position": "left"
      },
      {
        "color": "success",
        "id": "sub-usage-ok",
        "position": "right",
        "prefix": "󰛨 "
      },
      {
        "color": "warning",
        "id": "sub-usage-warn",
        "position": "right",
        "prefix": "󰛨 "
      },
      {
        "color": "error",
        "id": "sub-usage-crit",
        "position": "right",
        "prefix": "󰛨 "
      }
    ],
    "disabledSegments": [
      "thinking"
    ],
    "layout": {
      "left": [
        "model",
        "custom:effort",
        "path",
        "git"
      ]
    },
    "preset": "default"
  },
  "quietStartup": true,
  "shellCommandPrefix": "export PATH=\"${XDG_CACHE_HOME:-$HOME/.cache}/pi-fish-bridge/shims:$PATH\"",
  "showHardwareCursor": false,
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": true
  },
  "theme": "arcoiris-refined",
  "transport": "auto",
  "warnings": {
    "anthropicExtraUsage": false
  }
}
