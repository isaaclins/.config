{
  "name": "@isaaclins/pi-beeper",
  "version": "0.1.0",
  "description": "Native Pi tools for reading and confirmed writing to local Beeper Desktop chats",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package",
    "pi",
    "beeper",
    "chat"
  ],
  "exports": "./src/index.ts",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "pack-check": "node scripts/pack-check.mjs && npm pack --dry-run",
    "upgrade-check": "node scripts/upgrade-check.mjs"
  },
  "files": [
    "extension.ts",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@types/node": "24.12.4",
    "typebox": "1.3.6",
    "typescript": "5.9.3"
  }
}
