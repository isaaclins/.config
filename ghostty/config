# ~/.config/ghostty/config
# Purpose: Ghostty terminal config, trimmed to non-default overrides only.
# Usage: Reload with super+shift+comma. Docs: `ghostty +show-config --default --docs`
#        or https://ghostty.org/docs/config/reference

# Shell
command = /opt/homebrew/bin/fish
shell-integration = fish
shell-integration-features = cursor,no-sudo,title
quit-after-last-window-closed = true

# Font
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font Bold
font-family-italic = JetBrainsMono Nerd Font Italic
font-family-bold-italic = JetBrainsMono Nerd Font Bold Italic
font-feature = -liga
font-size = 12
font-thicken = true

# Appearance
theme = Arcoiris
# Override the theme's dark red cursor; dark text so glyphs stay readable
# under the white block cursor (theme would use near-white on white).
cursor-color = #ffffff
cursor-text = #201f1e
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
macos-titlebar-style = transparent

# Behavior
mouse-hide-while-typing = true
clipboard-read = allow

# Keybinds (only remaps; macOS defaults like super+c/v/a/t/w, shift+arrows and
# ctrl+tab are built in and not restated here)

# super+q closes the window instead of quitting; quit moves to super+shift+q.
keybind = super+q=close_window
keybind = super+shift+q=quit
keybind = super+shift+t=new_window

keybind = super+shift+plus=increase_font_size:1
keybind = super+shift+minus=decrease_font_size:1

keybind = ctrl+shift+i=inspector:toggle

# Option + Backspace: delete previous word (Ctrl-W)
keybind = opt+backspace=text:\x17
