# ~/.config/ghostty/config
# Purpose: Ghostty terminal config, trimmed to non-default overrides only.
# Usage: Reload with super+shift+comma. Docs: `ghostty +show-config --default --docs`
#        or https://ghostty.org/docs/config/reference

# Shell
command = /opt/homebrew/bin/fish
shell-integration = fish
shell-integration-features = cursor,no-sudo,title
quit-after-last-window-closed = true

# Font
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font Bold
font-family-italic = JetBrainsMono Nerd Font Italic
font-family-bold-italic = JetBrainsMono Nerd Font Bold Italic
font-feature = -liga
font-size = 12
font-thicken = true

# Appearance
theme = Arcoiris
# Override the theme's dark red cursor; dark text so glyphs stay readable
# under the white block cursor (theme would use near-white on white).
cursor-color = #ffffff
cursor-text = #201f1e
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
macos-titlebar-style = transparent

# Behavior
mouse-hide-while-typing = true
# Keep drag selection native and persistent even when local or remote apps
# (notably tmux over sshh) request terminal mouse reporting.
mouse-reporting = false
clipboard-read = allow

# Keybinds (only remaps; macOS defaults like super+c/v/a/t/w, shift+arrows and
# ctrl+tab are built in and not restated here)

# super+q closes the window instead of quitting; quit moves to super+shift+q.
keybind = super+q=close_window
keybind = super+shift+q=quit
keybind = super+shift+t=new_window

keybind = super+shift+plus=increase_font_size:1
keybind = super+shift+minus=decrease_font_size:1

keybind = ctrl+shift+i=inspector:toggle

# Option + Backspace: delete previous word. Sends ESC+DEL (alt-backspace,
# backward-kill-word in fish/readline) instead of Ctrl-W, because tmux now
# grabs ctrl+w for the WASD-as-arrows bindings (see tmux/tmux.conf).
keybind = opt+backspace=text:\x1b\x7f

# tmux multipane instead of Ghostty splits: forward the familiar split keys
# into tmux as prefix sequences (ctrl+b then % or "). Outside tmux these
# now just type a stray character instead of splitting Ghostty.
keybind = super+d=text:\x02%
keybind = super+shift+d=text:\x02\x22
# cmd+w closes the focused tmux pane (prefix+x, bound to kill-pane without
# confirm). Closing the actual Ghostty window stays on cmd+shift+w.
keybind = super+w=text:\x02x
