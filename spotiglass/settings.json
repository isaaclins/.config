{
  "equalizer" : {
    "bands" : [
      0,
      0,
      0,
      -2,
      -1,
      -0.5,
      3.5,
      3.5,
      7.5,
      -7.5
    ],
    "enabled" : false,
    "preamp" : 12,
    "userPresets" : [

    ]
  },
  "keybinds" : [
    {
      "command" : "app.openSettings",
      "keystrokes" : [
        "cmd-,"
      ],
      "when" : "always"
    },
    {
      "command" : "palette.open",
      "keystrokes" : [
        "cmd-k"
      ],
      "when" : "always"
    },
    {
      "command" : "playlists.refresh",
      "keystrokes" : [
        "cmd-r"
      ],
      "when" : "signed_in"
    },
    {
      "command" : "playlists.refreshTracks",
      "keystrokes" : [
        "cmd-t"
      ],
      "when" : "signed_in"
    },
    {
      "command" : "playback.connect",
      "keystrokes" : [
        "shift-cmd-k"
      ],
      "when" : "signed_in"
    },
    {
      "command" : "playback.toggle",
      "keystrokes" : [
        "space"
      ],
      "when" : "signed_in"
    },
    {
      "command" : "playback.next",
      "keystrokes" : [
        "shift-cmd-right"
      ],
      "when" : "signed_in"
    },
    {
      "command" : "playback.previous",
      "keystrokes" : [
        "shift-cmd-left"
      ],
      "when" : "signed_in"
    },
    {
      "command" : "queue.toggle",
      "keystrokes" : [
        "alt-cmd-q"
      ],
      "when" : "signed_in"
    },
    {
      "command" : "palette.pin",
      "keystrokes" : [
        "cmd-p"
      ],
      "when" : "palette_open"
    }
  ],
  "version" : 1
