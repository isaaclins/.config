#!/usr/bin/env bash
# ~/.config/.githooks/pre-commit
# Purpose: Hard-stop any commit that looks like it contains credentials. The
# shared agents umbrella (~/.config/agents/claude and ~/.config/agents/codex) and
# the retired ~/.config/claude home hold OAuth tokens, MCP env vars, auth.json,
# and session history under a defensive .gitignore; this hook is the second line
# of defence in case a path is force-added or the ignore rules drift.
# Wiring: `git config core.hooksPath .githooks` (done by bootstrap.sh).

set -euo pipefail

red()  { printf '\033[31m%s\033[0m\n' "$*" >&2; }
bold() { printf '\033[1m%s\033[0m\n' "$*" >&2; }

fail() {
    bold "pre-commit: refusing to commit - looks like a credential leak"
    red  "$*"
    red  ""
    red  "If this is a false positive, bypass with: git commit --no-verify"
    exit 1
}

# 0. gitleaks, when installed, brings a maintained ruleset (high-entropy and
# hundreds of token shapes) that the hand-rolled regex below cannot match.
# The regex scan still runs afterwards as an offline fallback.
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --no-banner --redact >/dev/null 2>&1; then
        fail "gitleaks found a secret in staged changes (details: gitleaks protect --staged --verbose)"
    fi
fi

# 1. Filename blocklist. Reject by path regardless of content.
blocked_paths='(^|/)(\.claude\.json|credentials([._-].*)?\.json|\.env(\..+)?|.*\.(pem|key|p12|pfx|asc|log))$'

while IFS= read -r path; do
    [ -z "$path" ] && continue
    if printf '%s\n' "$path" | grep -E -q "$blocked_paths"; then
        # Allow obvious example/template files.
        case "$path" in
            *.env.example|*.env.sample|*example.env) continue ;;
        esac
        fail "blocked filename: $path"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# 2. Content blocklist. Scan staged blob contents for token shapes.
secret_patterns='sk-ant-[A-Za-z0-9_-]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|glpat-[A-Za-z0-9_-]{20,}|npm_[A-Za-z0-9]{36}|AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|xox[abprs]-[A-Za-z0-9-]{10,}|bpr[_-][A-Za-z0-9_-]{20,}|beeper[_-][A-Za-z0-9_-]{20,}|eyJ[A-Za-z0-9_-]{17,}\.eyJ[A-Za-z0-9_-]{17,}\.[A-Za-z0-9_-]{10,}|-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----'

while IFS= read -r path; do
    [ -z "$path" ] && continue
    # Skip binary blobs — `git diff --cached` is quiet for them anyway.
    if git diff --cached -- "$path" | grep -E -q "$secret_patterns"; then
        hit=$(git diff --cached -- "$path" | grep -E -m1 -o "$secret_patterns" || true)
        fail "secret-shaped string in $path: ${hit:0:24}…"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# 3. Normalize pi/settings.json key order. pi rewrites the file with arbitrary
# key order on every save, which produces noisy diffs; sort keys deterministically
# before committing.
if git diff --cached --name-only | grep -q '^pi/settings\.json$'; then
    repo_root="$(git rev-parse --show-toplevel)"
    settings_path="$repo_root/pi/settings.json"
    if [ -f "$settings_path" ]; then
        python3 - "$settings_path" <<'PYSCRIPT'
import sys
import json

path = sys.argv[1]
try:
    with open(path, 'r', encoding='utf-8') as f:
        data = json.load(f)
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2, sort_keys=True, ensure_ascii=False)
        f.write('\n')
    print(f"Normalized: {path}")
except json.JSONDecodeError as e:
    print(f"Warning: {path} has invalid JSON ({e}), skipping normalization", file=sys.stderr)
    sys.exit(0)
except Exception as e:
    print(f"Warning: failed to normalize {path}: {e}", file=sys.stderr)
    sys.exit(0)
PYSCRIPT
        git add "$settings_path"
    fi
fi

exit 0
